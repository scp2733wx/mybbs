    {
      "name": "用户登录并获取 JWT",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// 从双重 envelope 里提取 token\r",
              "var jsonData = pm.response.json();\r",
              "var token = jsonData.data.access_token;\r",
              "\r",
              "if (token) {\r",
              "    pm.environment.set(\"token\", token);\r",
              "    console.log(\"Token saved: \" + token.substring(0, 20) + \"...\");\r",
              "} else {\r",
              "    console.log(\"Login failed, no token in response\");\r",
              "    console.log(\"Full response: \" + JSON.stringify(jsonData));\r",
              "}"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n    \"username\": \"20260001\",\r\n    \"password\": \"Recruit2026\"\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "http://127.0.0.1:8080/api/v1/auth/login",
